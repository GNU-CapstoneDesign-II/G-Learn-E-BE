# # 1. 빌드 단계: gradle: 버전명-jdkXX 이미지를 사용
# FROM gradle:8.13-jdk21 AS builder
#
# # 작업 디렉토리 설정
# WORKDIR /app
#
# # 프로젝트 소스 복사
# COPY . .
#
# # Gradle 빌드 (bootJar 사용 예시, 빌드 시 로그를 좀 더 자세히 보려면 --info)
# RUN gradle clean bootJar --no-daemon --info
#
# # 2. 실행 단계: 빌드된 Jar 파일을 실행할 JDK21 런타임
# FROM openjdk:21-slim
#
# WORKDIR /app
#
# # 빌드 단계에서 생성된 Jar 복사 (아래 경로는 예시이므로 실제 빌드 산출물 위치에 맞춰 수정)
# COPY --from=builder /app/build/libs/*.jar /app/app.jar
#
# # wait-for-it.sh 등 필요한 스크립트 복사 (이미 준비되었다고 가정)
# COPY wait-for-it.sh /app/wait-for-it.sh
# RUN chmod +x /app/wait-for-it.sh
#
# # 포트 공개 (선택)
# EXPOSE 8080
#
# # 컨테이너 기동 시 명령
# CMD ["/app/wait-for-it.sh", "fastapi_backend:8000", "--", "java", "-jar", "/app/app.jar"]


# ===== 1) build (캐시 최적화) =====
FROM gradle:8.10.2-jdk21 AS builder
WORKDIR /workspace

# 1-1) 의존성 캐시 레이어
COPY gradlew ./
COPY gradle ./gradle
COPY settings.gradle* build.gradle* ./
RUN chmod +x gradlew \
 && ./gradlew --no-daemon dependencies || true

# 1-2) 실제 소스 복사 후 빌드
COPY . .
RUN chmod +x ./gradlew
RUN ./gradlew --no-daemon clean bootJar

COPY wait-for-it.sh /app/wait-for-it.sh
RUN chmod +x /app/wait-for-it.sh

# ===== 2) runtime (경량 JRE) =====
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
ENV TZ=Asia/Seoul

# 산출물 복사 (app.jar 이름 고정 안 했으면 *.jar)
COPY --from=builder /workspace/build/libs/*.jar /app/app.jar

# (선택) 비루트 유저로 실행
RUN addgroup -S spring && adduser -S spring -G spring
USER spring

EXPOSE 8080


ENTRYPOINT ["sh","-c","/app/wait-for-it.sh fastapi_backend:8000 -- java $JAVA_OPTS -jar /app/app.jar"]

